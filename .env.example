# Copy to .env and change every value marked CHANGE ME.

# CHANGE ME
POSTGRES_PASSWORD=change-me-postgres
# CHANGE ME: python -c "import secrets; print(secrets.token_urlsafe(48))"
SENTINEL_JWT_SECRET=change-me-to-a-long-random-string
# CHANGE ME: shared secret for every agent
SENTINEL_INGEST_TOKEN=change-me-agent-token
SENTINEL_ADMIN_EMAIL=admin@sentinel.local
# CHANGE ME (at least 10 characters)
SENTINEL_ADMIN_PASSWORD=change-me-admin-pass
SENTINEL_CORS_ORIGINS=http://localhost:5173
SENTINEL_JWT_TTL_MINUTES=60

# Optional Telegram alerts: create a bot with @BotFather, then put its token and your chat id here.
SENTINEL_TELEGRAM_TOKEN=
SENTINEL_TELEGRAM_CHAT_ID=
SENTINEL_NOTIFY_MIN_SEVERITY=high
